---
import { getCollection } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import CopyButton from '@components/CopyButton.astro';
import Section from '@components/Section.astro';
import ProjectCard from '@components/ProjectCardC.astro';
import ArticleCard from '@components/ArticleCard.astro';

import ProfileIcon from '@assets/profile.svg';
import RightArrowIcon from '@assets/icons/arrow-right.svg';
import MailIcon from '@assets/icons/mail.svg';
import GitHubIcon from '@assets/icons/github.svg';
import LinkedInIcon from '@assets/icons/linkedin.svg';

import { FULL_NAME, ROLE, LOCATION, EMAIL, SOCIAL_LINKS, GITHUB, LINKEDIN } from '@utils/globals';

const base = import.meta.env.BASE_URL;
const isProd = import.meta.env.PROD;

// TODO: get 3 recent posts
async function getPosts() {
  const posts = await getCollection('blog', ({ data }) => (isProd ? !data.draft : true));
  return posts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
}

async function getProjects() {
  const projects = await getCollection('projects', ({ data }) => (isProd ? !data.draft : true));
  const featured = projects.filter((p) => p.data.featured !== undefined);
  return featured.sort((a, b) => a.data.featured! - b.data.featured!);
}

const posts = await getPosts();
const projects = await getProjects();

const title = `${FULL_NAME} - ${ROLE}`;
const description = 'Software developer building websites and games.';
---

<BaseLayout title={title} description={description} image={ProfileIcon}>
  <div class="mx-auto w-full max-w-3xl px-5 sm:px-6">
    {/* ------------------------------ Hero ------------------------------ */}
    <section class="pt-14 sm:pt-20">
      <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:text-left">
        <ProfileIcon
          width="80"
          height="80"
          class="size-26 rounded-full border border-border bg-muted ring-2 ring-accent/25 ring-offset-2 ring-offset-background sm:size-20"
        />
        <div class="min-w-0">
          <h1 class="text-3xl font-extrabold tracking-tight sm:text-6xl">{FULL_NAME}</h1>
          <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-base text-muted-foreground">
            <span>{ROLE}</span>
            <span aria-hidden="true" class="opacity-50">
              ·
            </span>
            <span>{LOCATION}</span>
            <span aria-hidden="true" class="hidden opacity-50 sm:inline">
              ·
            </span>
            <span class="hidden items-center gap-0.5 sm:inline-flex">
              {EMAIL}
              <CopyButton text={EMAIL} label="Copy email address" />
            </span>
          </p>
        </div>
      </div>

      <!--p class="mt-15 max-w-6xl text-xl sm:text-2xl font-semibold leading-relaxed text-balance">
        Software developer building websites and games.
      </p-->
      <!--p class="mt-15 max-w-6xl text-xl sm:text-2xl font-semibold leading-relaxed text-balance">
        Here's a quote I think is cool
      </!--p>
      <p-- class="mt-3 max-w-6xl sm:text-lg text-base leading-relaxed text-muted-foreground">
        "In an age where you can churn out any generic garbadge in seconds, authentic and real
        creations are more valuable than ever".
      </p-->

      <!--div class="mt-7 flex flex-wrap items-center gap-3">
        <Button href={'mailto:' + EMAIL} size="lg">
          <MailIcon width={14} height={14} />
          Get in Touch
        </Button>
        <Button href={GITHUB} variant="secondary" size="lg">
          <GitHubIcon width={14} height={14} />
          GitHub
        </Button>
        <Button-- href={LINKEDIN} variant="secondary" size="lg">
          <LinkedInIcon width={14} height={14} />
          LinkedIn
        </Button-->
      <!--Button href={`${base}/projects`} variant="secondary" size="lg">
          View Projects
        </Button>
        <Button href={`${base}/blog`} variant="secondary" size="lg">
          Read Blog
        </Button>
      </div-->

      <!--ul class:list={'flex items-center gap-1 mt-6 -ml-2'}>
        {SOCIAL_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={link.name}
              class="inline-flex size-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            >
              <link.icon width={20} height={20} />
            </a>
          </li>
        ))}
      </ul-->
    </section>

    {/* ---------------------- Featured projects ------------------------- */}
    <Section title="Featured projects" href={`${base}/projects`}>
      <div class="grid gap-4 sm:grid-cols-2">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </Section>

    {/* ----------------------- Latest articles -------------------------- */}
    <Section title="Latest articles" href={`${base}/blog`}>
      <div class="flex flex-col">
        {posts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </Section>
  </div>
</BaseLayout>
