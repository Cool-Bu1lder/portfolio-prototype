---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  external?: boolean;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  type = 'button',
  external = false,
  ...rest
} = Astro.props;

const variants = {
  primary: 'bg-primary text-primary-foreground hover:bg-primary/85',
  secondary: 'border border-border bg-card text-foreground hover:bg-muted',
  ghost: 'text-muted-foreground hover:bg-muted hover:text-foreground',
  accent: 'bg-accent text-accent-foreground hover:bg-accent/85',
};

const sizes = {
  sm: 'h-8 px-3 text-xs',
  md: 'h-10 px-4 text-sm',
  lg: 'h-12 px-5 text-base',
};

const baseClasses =
  'inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50';

const conditionalProps = href && external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const Tag = href ? 'a' : 'button';

// TODO:  convert this to pure css?
---

<Tag
  {...(href ? { href } : { type })}
  class:list={[baseClasses, variants[variant], sizes[size], className]}
  {...conditionalProps}
  {...rest}
>
  <slot />
</Tag>
