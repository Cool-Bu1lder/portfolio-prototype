---
import { type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import Badge from '@components/Badge.astro';

import GitHubIcon from '@assets/icons/github.svg';
import ExternalLinkIcon from '@assets/icons/external-link.svg';

const base = import.meta.env.BASE_URL;

interface Props {
  project: CollectionEntry<'projects'>;
  showImage?: boolean;
}

const { project, showImage = true } = Astro.props;
const { data } = project;
const href = `${base}/projects/${project.id}`;
---

<article class="group relative flex flex-col overflow-hidden rounded-xl bg-card/60 transition-colors hover:bg-card">
  {showImage && data.image && (
    <Image
      src={data.image}
      alt={`Screenshot of ${data.title}`}
      width={1280}
      height={720}
      loading="lazy"
      decoding="async"
      class="aspect-video w-full border-b border-border object-cover"
    />
  )}

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-semibold tracking-tight">
        <a
          href={href}
          class="after:absolute after:inset-0 transition-colors group-hover:text-accent"
        >
          {data.title}
        </a>
      </h3>
      {(data.developing && <Badge variant="warning">In progress</Badge>) || (
        <p class="ml-auto font-mono text-[0.6875rem] text-muted-foreground">{data.year}</p>
      )}
    </div>

    <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground">
      {data.description}
    </p>

    <div class="mt-4 flex items-center justify-between gap-4">
      <div class="flex flex-wrap gap-1.5">
        {data.technologies.slice(0, 5).map((tech) => (
          <span class="rounded-md bg-muted px-2 py-0.5 font-mono text-[0.6875rem] text-muted-foreground">
            {tech}
          </span>
        ))}
      </div>

      <div class="flex items-center gap-1">
        {data.github && (
          <a
            href={data.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${data.title} on GitHub`}
            class="z-10 inline-flex items-center justify-center rounded-md text-accent transition-colors hover:text-foreground"
          >
            <GitHubIcon width={14} height={14} />
          </a>
        )}
        {data.demo && (
          <a
            href={data.demo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Live demo of ${data.title}`}
            class="z-10 inline-flex items-center justify-center rounded-md text-accent transition-colors hover:text-foreground"
          >
            <ExternalLinkIcon width={14} height={14} />
          </a>
        )}
      </div>
    </div>
  </div>
</article>
