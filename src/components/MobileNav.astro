---
import MenuIcon from '@assets/icons/menu.svg';
import CloseIcon from '@assets/icons/x.svg';

import { NAV_LINKS } from '@utils/globals';

// TODO: use react component?
---

<button
  type="button"
  id="mobile-nav-toggle"
  class="inline-flex size-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-nav-panel"
>
  <MenuIcon width={18} height={18} class="menu-icon" />
  <CloseIcon width={18} height={18} class="close-icon hidden" />
</button>

<div
  id="mobile-nav-panel"
  hidden
  class="absolute inset-x-0 top-14 z-30 border-b border-border/50 bg-background/95 backdrop-blur-md md:hidden"
>
  <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile navigation">
    {NAV_LINKS.map((item) => (
      <a
        href={item.href}
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
      >
        {item.label}
      </a>
    ))}
  </nav>
</div>

<script>
  function initMobileNav() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    if (!toggle || !panel) return;

    const menuIcon = toggle.querySelector('.menu-icon');
    const closeIcon = toggle.querySelector('.close-icon');

    function setOpen(open: boolean) {
      panel!.hidden = !open;
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      menuIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    }

    toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });

    // Close when a link is chosen
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
  initMobileNav();
</script>
