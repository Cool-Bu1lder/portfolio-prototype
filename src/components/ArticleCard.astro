---
import { type CollectionEntry } from 'astro:content';

import { formatDate, isoDate } from '@utils/date';

import TagBadge from './TagBadge.astro';

const base = import.meta.env.BASE_URL;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const href = `${base}/blog/${post.id}`;
---

<article class="group relative -mx-4 rounded-xl px-4 py-4 transition-colors hover:bg-muted/60">
  <div class="flex items-start justify-between gap-6">
    <div class="min-w-0">
      <h3 class="font-medium tracking-tight text-balance">
        <a
          href={href}
          class="after:absolute after:inset-0 transition-colors group-hover:text-accent"
        >
          {post.data.title}
        </a>
      </h3>
      <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
        {post.data.description}
      </p>
      {post.data.tags.length > 0 && (
        <div class="relative z-10 mt-3 flex flex-wrap gap-1.5">
          {post.data.tags.slice(0, 4).map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}
    </div>
    <div class="shrink-0 text-right text-xs text-muted-foreground">
      <time datetime={isoDate(post.data.publishedAt)} class="block">
        {formatDate(post.data.publishedAt)}
      </time>
    </div>
  </div>
</article>
