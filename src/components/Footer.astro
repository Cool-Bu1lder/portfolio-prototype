---
import ProfileIcon from '@assets/profile.svg';

import { SITE_NAME, FULL_NAME, ROLE, SOCIAL_LINKS } from '@utils/globals';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="mt-24">
  <div class="mx-auto w-full max-w-3xl px-5 sm:px-6 py-12">
    <div class="mt-10 flex flex-col items-center justify-center gap-2 pt-6 text-xs text-muted-foreground">
      <p>
        © {year} {FULL_NAME}.
      </p>
    </div>
  </div>
</footer>
