---
import RightArrowIcon from '@assets/icons/arrow-right.svg';

interface Props {
  title: string;
  /** Optional "View all" style link (internal paths get the base prefix) */
  href?: string;
  linkLabel?: string;
  class?: string;
}

const { title, href, linkLabel = 'View all', class: className } = Astro.props;
---

<section class:list={['mt-16 sm:mt-20', className]}>
  <div class="mb-6 flex items-baseline justify-between">
    <h2 class="text-xl sm:text-2xl font-semibold tracking-tight">{title}</h2>
    {href && (
      <a
        href={href}
        class="group inline-flex items-center gap-1 text-xs font-medium text-accent transition-colors hover:text-foreground"
      >
        {linkLabel}
        <RightArrowIcon
          width={12}
          height={12}
          class="transition-transform group-hover:translate-x-0.5"
        />
      </a>
    )}
  </div>
  <slot />
</section>
